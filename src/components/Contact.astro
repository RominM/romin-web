---
// Clé publique Cloudflare Turnstile (variable d'env Netlify, lue au build).
// Si elle est absente, le widget n'est simplement pas affiché.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact-box">
      <div class="contact-box__left reveal">
        <p class="section-label">Parlons de votre projet</p>
        <h2 class="section-title">Vous avez une idée ?<br />Je m'occupe du reste.</h2>
        <p class="section-desc">
          Décrivez-moi votre activité et ce que vous attendez de votre site.
          Je vous réponds sous 24h avec un premier retour gratuit.
        </p>

        <div class="contact-box__reassurance">
          <div class="contact-reassurance-item">
            <span>⚡</span>
            <span>Réponse sous 24h</span>
          </div>
          <div class="contact-reassurance-item">
            <span>🎁</span>
            <span>Devis 100 % gratuit</span>
          </div>
          <div class="contact-reassurance-item">
            <span>🤝</span>
            <span>Sans engagement</span>
          </div>
        </div>
      </div>

      <form class="contact-form reveal reveal-delay-2" name="contact" method="POST" action="/.netlify/functions/contact">

        <div class="contact-form__group">
          <label for="name">Votre nom</label>
          <input type="text" id="name" name="name" placeholder="Marie Dupont" required />
        </div>
        <div class="contact-form__group">
          <label for="business">Votre activité</label>
          <input type="text" id="business" name="business" placeholder="Ex : coiffeuse, restaurant, plombier…" required />
        </div>
        <div class="contact-form__group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="vous@exemple.fr" required />
        </div>
        <div class="contact-form__group">
          <label for="phone">Téléphone <span class="contact-form__optional">(facultatif)</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="06 12 34 56 78"
            autocomplete="tel"
            maxlength="30"
            pattern={String.raw`[0-9+\(\)\.\s\-]{6,30}`}
            title="Chiffres, espaces et + uniquement"
          />
        </div>
        <div class="contact-form__group">
          <label for="message">Votre projet en quelques mots</label>
          <textarea id="message" name="message" rows="4" placeholder="Je n'ai pas encore de site, je voudrais quelque chose de simple pour présenter mes services…" required></textarea>
        </div>

        <!-- Anti-spam : champ piège, invisible pour les humains. Un bot le remplit. -->
        <div class="contact-form__hp" aria-hidden="true">
          <label for="website">Ne pas remplir ce champ</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <!-- Anti-spam : heure d'ouverture du formulaire, remplie par le script ci-dessous -->
        <input type="hidden" name="ts" value="" />

        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language="fr" data-theme="light"></div>
        )}

        <p class="contact-form__error" role="alert" hidden>
          Vérification anti-robot en cours, merci de réessayer dans un instant.
        </p>

        <button type="submit" class="btn btn--coral">Envoyer ma demande →</button>

        <p class="contact-form__notice">
          En envoyant ce formulaire, vous acceptez d'être recontacté par email ou par téléphone
          au sujet de votre demande. Vos données ne sont jamais revendues.
          <a href="/mentions-legales">En savoir plus</a>
        </p>
      </form>
    </div>
  </div>
</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('form.contact-form')
  if (form) {
    const ts = form.querySelector<HTMLInputElement>('input[name="ts"]')
    if (ts) ts.value = String(Date.now())

    const error = form.querySelector<HTMLElement>('.contact-form__error')
    form.addEventListener('submit', (e) => {
      // Si Turnstile est actif, on attend que la vérification soit terminée
      if (!form.querySelector('.cf-turnstile')) return
      const token = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')
      if (!token || !token.value) {
        e.preventDefault()
        if (error) error.hidden = false
      }
    })
  }
</script>

<style lang="scss">
  @use '../styles/foundations' as *;

  .contact-box {
    display: grid;
    gap: 2rem;

    @include respond-to('lg') {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 4rem;
    }

    &__left {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    &__reassurance {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  .contact-reassurance-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: $color-text-muted;

    span:first-child { font-size: 1rem; }
  }

  .contact-form {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px) saturate(140%);
    -webkit-backdrop-filter: blur(8px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: $radius-lg;
    padding: 1.25rem;
    box-shadow: 0 4px 24px rgba(120, 100, 180, 0.09);
    display: flex;

    @include respond-to('md') { padding: 2rem; }
    flex-direction: column;
    gap: 1.25rem;

    // Champ piège : hors écran plutôt que display:none (que certains bots détectent)
    &__hp {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    &__optional {
      font-weight: 400;
      color: $color-text-subtle;
    }

    &__notice {
      font-size: 0.78rem;
      line-height: 1.5;
      color: $color-text-subtle;
      text-align: center;

      a {
        color: inherit;
        text-decoration: underline;
      }
    }

    &__error {
      font-size: 0.85rem;
      color: $color-text-muted;
    }

    &__group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      label {
        font-size: 0.85rem;
        font-weight: 600;
        color: $color-text;
      }

      input, textarea {
        background: $color-bg;
        border: 1.5px solid $color-border;
        border-radius: $radius-sm;
        padding: 0.7rem 1rem;
        color: $color-text;
        font-size: 0.95rem;
        transition: border-color $transition, box-shadow $transition;
        resize: vertical;

        &::placeholder { color: $color-text-subtle; }

        &:focus {
          outline: none;
          border-color: $color-accent;
          box-shadow: 0 0 0 3px rgba($color-accent, 0.1);
        }
      }
    }
  }
</style>
